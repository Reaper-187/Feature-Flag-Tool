generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User Schema
enum UserRole {
  DEV
  ADMIN
  GUEST
}

model users {
  user_id       String   @id @default(uuid()) @db.Uuid
  user_name     String   @db.VarChar(100)
  user_email    String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  role          UserRole
  created_at    DateTime @default(now())

  wrong_pw_count Int     @default(0)
  blocked        Boolean @default(false)

  verify_status    Boolean   @default(false)
  verify_token     String?   @unique
  verify_token_exp DateTime?

  reset_token     String?   @unique
  reset_token_exp DateTime?

  refresh_token     String?   @unique
  refresh_token_exp DateTime?
}

// Das Schema beschreibt das Fetaure
model flags {
  flag_id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flag_name         String              @unique @db.VarChar(100)
  flag_key_name     String              @unique @db.VarChar(100)
  description       String?
  flag_rollout      Int
  created_by        String              @db.VarChar(100)
  created_date      DateTime            @default(now()) @db.Timestamp(6)
  flag_environments flag_environments[]
}

// speichert ob das feature Aktiviert ist
model flag_environments {
  flag_id        String       @db.Uuid
  environment_id Int
  is_enabled     Boolean      @default(false)
  environments   environments @relation(fields: [environment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  flags          flags        @relation(fields: [flag_id], references: [flag_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([flag_id, environment_id])
}

// beschriebt dev,stage und prodSwitch
model environments {
  id                Int                 @id @default(autoincrement())
  name              String              @unique @db.VarChar(50)
  flag_environments flag_environments[]
}

// environments ---- enthält nur die Liste der Umgebungen
//    ↑
//    │
// flag_environments ---- verbindet beides (n:m)
//    │
//    ↓
// flags ---- enthält das Feature
